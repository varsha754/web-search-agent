# DuckDuckGo settings
DDG_MAX_RESULTS=10
DDG_TIMEOUT=10
DDG_REGION=wt-wt

# OpenAI settings
# Put your real key only in .env, never in this file.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=500

# Content processing
MAX_CONTENT_LENGTH=5000
EXTRACT_READABLE=true

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=data/cache

# Rate limiting
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Response format
DEFAULT_FORMAT=markdown
MAX_RESULTS_IN_RESPONSE=5

# Web interface
API_HOST=0.0.0.0
API_PORT=8000
